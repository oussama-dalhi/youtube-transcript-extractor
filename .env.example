
# TranscriptAPI
TRANSCRIPT_API_KEY=your_transcriptapi_key

# PostgreSQL (local). On the live site, DATABASE_URL is set in the
# FastAPI Cloud dashboard instead (for example, a Neon connection string).
DATABASE_URL=postgresql://transcript_app:your_database_password@localhost:5432/transcripts

# Session security
SESSION_SECRET=your_random_secret_key

# Production only: set APP_ENV=production in the dashboard (enables Secure cookies).
# Leave it unset locally so login works over http://localhost.
