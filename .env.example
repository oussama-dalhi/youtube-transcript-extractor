# Copy this file to .env and fill in your key. Never commit the real .env file.
# Get a key at https://transcriptapi.com/ (new accounts get 100 free credits).

# TranscriptAPI
TRANSCRIPT_API_KEY=your_transcriptapi_key

# PostgreSQL
DATABASE_URL=postgresql://transcript_app:your_database_password@localhost:5432/transcripts

# Session security
SESSION_SECRET=your_random_secret_key
